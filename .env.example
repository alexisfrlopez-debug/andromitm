# AndroMITM — Variables d'environnement (copier vers .env)
# ⚠ NE JAMAIS committer ce fichier ni déposer de tokens dans le repo.

# Port du dashboard (défaut 8443)
ANDROMITM_PORT=8443

# Interface d'écoute : 127.0.0.1 (défaut, sûr) ou 0.0.0.0 (accessible depuis le LAN)
ANDROMITM_HOST=127.0.0.1

# Mode simulation : 1 = aucun binaire externe requis, moteur factice pour tests/démo
ANDROMITM_SIM=0

# Répertoire de données (sessions, logs, pcaps) — défaut ./data
ANDROMITM_DATA=./data

# Token GitHub pour les scripts de backup (optionnel, peut aussi venir de tokens/token_git.txt)
GITHUB_TOKEN=

# Dossier Drive de travail (rclone remote + ID)
ANDROMITM_DRIVE_REMOTE=gdrive
ANDROMITM_DRIVE_FOLDER_ID=1Ps1dQJFWgM6H_xpYRSzTqKuOtVNsdDYj
